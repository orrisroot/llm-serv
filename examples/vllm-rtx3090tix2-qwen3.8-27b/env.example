VLLM_API_KEY="sk-SECRET_API_KEY"

# Tensor-parallel GPUs; the degree is derived from the device count
#CUDA_VISIBLE_DEVICES="0,1"
#LLM_TENSOR_PARALLEL_SIZE=2

# Linear GEMM backend (default: marlin on Ampere, auto on Blackwell)
#LLM_LINEAR_BACKEND="marlin"

# CUDA-graph mode (default: FULL_AND_PIECEWISE)
#LLM_CUDAGRAPH_MODE="FULL_AND_PIECEWISE"
#LLM_CUDAGRAPH_CAPTURE_SIZES="[1,2,4,8,16,32]"

# NCCL transport for CUDA-graph replay
#NCCL_ALGO="Ring"
#NCCL_PROTO="Simple"

# Default thinking effort for requests that do not set one
# (low, medium, xhigh; the model default is xhigh)
#LLM_REASONING_EFFORT="medium"

# Turn thinking off entirely (true/false; the model default is on)
#LLM_ENABLE_THINKING=false

# Context length and concurrent sequences (default: 256k / 32)
#LLM_MAX_MODEL_LEN=262144
#LLM_MAX_NUM_SEQS=32

# GPU memory utilization (default: 0.93)
#LLM_GPU_MEMORY_UTILIZATION=0.93

# KV cache dtype (default: fp8)
#LLM_KV_CACHE_DTYPE="fp8"

# MTP speculative decoding (default: off; see README)
#LLM_MTP_TOKENS=4

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
