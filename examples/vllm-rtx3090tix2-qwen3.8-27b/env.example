VLLM_API_KEY="sk-SECRET_API_KEY"

# Tensor-parallel GPUs; the degree is derived from the device count unless
# LLM_TENSOR_PARALLEL_SIZE is set (default: 0,1 -> TP2)
#CUDA_VISIBLE_DEVICES="0,1"
#LLM_TENSOR_PARALLEL_SIZE=2

# Linear GEMM backend (default: marlin on Ampere/Turing, auto on Blackwell).
# nicosuter AWQ is W4A16; on Ampere Marlin is the fast W4A16 kernel.
#LLM_LINEAR_BACKEND="marlin"

# CUDA-graph mode. FULL_AND_PIECEWISE (default) captures the whole decode
# step into one graph -- the fork's Ampere optimisation. Requires the NCCL
# pin in `run`; if capture OOMs, switch to FULL_DECODE_ONLY or raise
# LLM_GPU_MEMORY_UTILIZATION headroom.
#LLM_CUDAGRAPH_MODE="FULL_AND_PIECEWISE"
#LLM_CUDAGRAPH_CAPTURE_SIZES="[1,2,4,8,16,32]"

# NCCL transport for graph-capturable collectives (the fork's documented
# Ampere requirement). Override only if the host needs a different transport.
#NCCL_ALGO="Ring"
#NCCL_PROTO="Simple"

# Default thinking effort for requests that do not set one
# (low, medium, xhigh; the model default is xhigh)
#LLM_REASONING_EFFORT="medium"

# Turn thinking off entirely (true/false; the model default is on)
#LLM_ENABLE_THINKING=false

# Context length and concurrent sequences (default: 256k / 32 — the model's
# maximum context). The KV pool (~599k tokens measured) caps real concurrency
# at ~2 for 256K requests; lower the context to raise concurrency.
#LLM_MAX_MODEL_LEN=262144
#LLM_MAX_NUM_SEQS=32

# GPU memory utilization (default: 0.95, tuned on the target host). The AWQ
# weights (~12 GiB/GPU at TP2) leave roughly 10 GiB/GPU for the FP8 KV cache.
#LLM_GPU_MEMORY_UTILIZATION=0.95

# KV cache dtype (default: fp8). Halves KV memory vs bf16; the model ships
# with FP8 KV calibration.
#LLM_KV_CACHE_DTYPE="fp8"

# MTP speculative decoding. Measured on this hardware: hurts W4A16 targets
# (this model) -- keep unset for the recommended profile. Set to a number of
# draft tokens (e.g. 4) to enable anyway.
#LLM_MTP_TOKENS=4

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
