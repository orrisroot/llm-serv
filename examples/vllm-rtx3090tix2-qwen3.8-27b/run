#!/usr/bin/env bash
set -euo pipefail

# Instance identity, derived from where this script is installed:
# /opt/llm-serv/<instance>/run
INSTANCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTANCE="$(basename -- "${INSTANCE_DIR}")"

# CUDA and virtualenv environment configuration. Ampere (sm_86) is supported
# by the full CUDA 13 stack, so point CUDA_HOME at the standard toolkit
# symlink (override else in the env file if the host keeps several versions).
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export VIRTUAL_ENV="${INSTANCE_DIR}/.venv"
export PATH="${CUDA_HOME}/bin:${VIRTUAL_ENV}/bin:${PATH}"

# NCCL transport pinned for FULL_AND_PIECEWISE CUDA graphs. Graph replay must
# re-issue the exact captured collective, and NCCL's size-adaptive algorithm
# switching is what makes FULL capture crash on Ampere (vllm-backport docs).
# Overridable from the env file.
export NCCL_ALGO="${NCCL_ALGO:-Ring}"
export NCCL_PROTO="${NCCL_PROTO:-Simple}"

# Load environment configuration file if present
ENV_FILE="/etc/llm-serv/${INSTANCE}.env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "${ENV_FILE}"
  set +a
fi

# Ensure API key is configured. It reaches the server through the environment
# (exported above), never as a command-line flag, so it stays out of ps output.
if [[ -z "${VLLM_API_KEY:-}" ]]; then
  echo "Error: VLLM_API_KEY is not set." >&2
  exit 1
fi

# Server and model configuration
VLLM_BIN="${VIRTUAL_ENV}/bin/vllm"
MODEL_DIR="/opt/llm-serv/models"
MODEL_PATH="nicosuter/Qwen3.8-27B-AWQ"
MODEL_ALIAS="qwen3.8-27b-awq"

# Tensor-parallel GPUs and degree. The degree defaults to the number of
# visible devices. Both overridable from the env file.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"
if [[ -n "${LLM_TENSOR_PARALLEL_SIZE:-}" ]]; then
  TP_SIZE="${LLM_TENSOR_PARALLEL_SIZE}"
else
  IFS=, read -r -a TP_DEVICES <<< "${CUDA_VISIBLE_DEVICES}"
  TP_SIZE="${#TP_DEVICES[@]}"
fi

# Linear backend. nicosuter AWQ is a compressed-tensors W4A16 quant with
# INT8 (GatedDeltaNet input projections preserved at 8-bit); on Ampere its
# 4-bit layers run as W4A16 GEMMs and Marlin is the fast, verified kernel.
# Blackwell might prefer auto; the capability gate keeps the script correct
# on both, and LLM_LINEAR_BACKEND overrides either way.
LINEAR_BACKEND=""
CC_MAJOR="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | awk -F. 'NR==1{print $1}')"
if [[ -n "${CC_MAJOR}" ]] && (( CC_MAJOR >= 10 )); then
  LINEAR_BACKEND="${LLM_LINEAR_BACKEND:-auto}"
else
  LINEAR_BACKEND="${LLM_LINEAR_BACKEND:-marlin}"
fi

# Listen address; both may be overridden from the env file
HOST="${LLM_SERV_HOST:-0.0.0.0}"
PORT="${LLM_SERV_PORT:-8000}"

# CUDA-graph mode. vllm-backport's FULL_AND_PIECEWISE captures the whole
# decode step (attention + GEMMs + NCCL all-reduce) into one CUDA graph —
# the fork's Ampere gain. Requires the NCCL pin and bounded capture sizes
# (FULL graphs keep private memory pools; too many sizes OOM warmup).
# cudagraph_capture_sizes derives from the actual --max-num-seqs; override
# via LLM_CUDAGRAPH_CAPTURE_SIZES (JSON list).
MAX_NUM_SEQS="${LLM_MAX_NUM_SEQS:-32}"
CUDAGRAPH_MODE="${LLM_CUDAGRAPH_MODE:-FULL_AND_PIECEWISE}"
if [[ -n "${LLM_CUDAGRAPH_CAPTURE_SIZES:-}" ]]; then
  CUDAGRAPH_CAPTURE_SIZES="${LLM_CUDAGRAPH_CAPTURE_SIZES}"
else
  CAPTURE_SIZES=()
  for ((i = 1; i <= MAX_NUM_SEQS; i++)); do CAPTURE_SIZES+=("${i}"); done
  CUDAGRAPH_CAPTURE_SIZES="[$(IFS=,; printf '%s' "${CAPTURE_SIZES[*]}")]"
fi

# Context, concurrency and memory profile. nicosuter AWQ is ~12 GiB/GPU at
# TP2, leaving roughly 10 GiB/GPU for the FP8 KV cache at 0.95 utilization —
# enough for ~2 concurrent 256K-token requests (measured KV pool 673k tokens).
# Defaults: the model's maximum context. All overridable from the env file.
MAX_MODEL_LEN="${LLM_MAX_MODEL_LEN:-262144}"
GPU_MEMORY_UTILIZATION="${LLM_GPU_MEMORY_UTILIZATION:-0.95}"
MAX_NUM_BATCHED_TOKENS="${LLM_MAX_NUM_BATCHED_TOKENS:-8192}"
KV_CACHE_DTYPE="${LLM_KV_CACHE_DTYPE:-fp8}"

# Default chat-template overrides, applied to requests that do not set their
# own. The Qwen3.8 template accepts reasoning_effort of low, medium, xhigh
# (model default xhigh), and enable_thinking=false turns thinking off. Both
# overridable from the env file.
EXTRA_ARGS=()
TEMPLATE_KWARGS=()
if [[ -n "${LLM_REASONING_EFFORT:-}" ]]; then
  case "${LLM_REASONING_EFFORT}" in
    low|medium|xhigh) ;;
    *) echo "Error: LLM_REASONING_EFFORT must be one of low, medium, xhigh (got: ${LLM_REASONING_EFFORT})." >&2; exit 1 ;;
  esac
  TEMPLATE_KWARGS+=("\"reasoning_effort\": \"${LLM_REASONING_EFFORT}\"")
fi
if [[ -n "${LLM_ENABLE_THINKING:-}" ]]; then
  case "${LLM_ENABLE_THINKING}" in
    true|false) ;;
    *) echo "Error: LLM_ENABLE_THINKING must be true or false (got: ${LLM_ENABLE_THINKING})." >&2; exit 1 ;;
  esac
  TEMPLATE_KWARGS+=("\"enable_thinking\": ${LLM_ENABLE_THINKING}")
fi
if (( ${#TEMPLATE_KWARGS[@]} > 0 )); then
  EXTRA_ARGS+=(--default-chat-template-kwargs "$(IFS=,; printf '{%s}' "${TEMPLATE_KWARGS[*]}")")
fi

# MTP speculative decoding, opt-in. Measured on this hardware class: MTP3/4
# accelerates NVFP4 targets (thinking-on single stream +20-31%) but hurts
# AWQ/GPTQ W4A16 targets (see README comparison), so this run ships MTP off
# by default. Set LLM_MTP_TOKENS to enable `--speculative-config
# {"method":"mtp", ...}` with N draft tokens.
if [[ -n "${LLM_MTP_TOKENS:-}" ]]; then
  EXTRA_ARGS+=(--speculative-config "{\"method\":\"mtp\",\"num_speculative_tokens\":${LLM_MTP_TOKENS}}")
fi

# Launch vllm-backport with ${TP_SIZE}-way tensor parallelism over the AWQ
# checkpoint. --disable-custom-all-reduce pairs with the NCCL pin above for
# graph-capturable collectives (the fork's documented Ampere requirement).
# The working directory must stay outside any source checkout, or Python
# imports the source tree instead of the wheel's CUDA extensions.
exec "${VLLM_BIN}" serve "${MODEL_DIR}/${MODEL_PATH}" \
  --served-model-name "${MODEL_ALIAS}" \
  --trust-remote-code \
  --tensor-parallel-size "${TP_SIZE}" \
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION}" \
  --max-model-len "${MAX_MODEL_LEN}" \
  --max-num-seqs "${MAX_NUM_SEQS}" \
  --max-num-batched-tokens "${MAX_NUM_BATCHED_TOKENS}" \
  --kv-cache-dtype "${KV_CACHE_DTYPE}" \
  --linear-backend "${LINEAR_BACKEND}" \
  --disable-custom-all-reduce \
  --compilation-config "{\"cudagraph_mode\":\"${CUDAGRAPH_MODE}\",\"max_cudagraph_capture_size\":${MAX_NUM_SEQS},\"cudagraph_capture_sizes\":${CUDAGRAPH_CAPTURE_SIZES}}" \
  --tool-call-parser qwen3_coder \
  --enable-auto-tool-choice \
  --reasoning-parser qwen3 \
  "${EXTRA_ARGS[@]}" \
  --host "${HOST}" \
  --port "${PORT}"
