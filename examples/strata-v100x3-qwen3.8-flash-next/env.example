# API key for the Strata server. Set it from the operator's secret store
# (e.g. the KEY.txt next to this repository); the value is never committed.
# The one-time setup launch must run with --no-api-key so the generated key
# does not replace this one (see README.md).
STRATA_API_KEY="sk-SECRET_API_KEY"

# Listen address; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"

# Optional tuning (see the engine reference in the Strata docs). These are
# read by the setup launch only; to change a running instance, edit the run
# config's "args"/"env" and `systemctl restart llm-serv@strata`.
#STRATA_CONTEXT="256k"
#STRATA_GPUS="0,1,2"
#STRATA_TUNE="skip"          # quick | thorough | skip
