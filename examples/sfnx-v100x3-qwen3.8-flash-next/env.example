# API key for the server. Set it from the operator's secret store
# (e.g. the KEY.txt next to this repository); the value is never committed.
# The front server reads it from this env file — it is never a command-line
# flag, so it stays out of `ps` output.
STRATA_API_KEY="sk-SECRET_API_KEY"

# Listen address; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"

# sFNX checkout and config (defaults shown):
#SFNX_HOME="/opt/sfnx"
#SFNX_CONFIG="/opt/sfnx/serve/sfnx.json"

# Engine/model settings live in serve/sfnx.json inside the checkout
# (model shards, draft layer, --spec, --batch, --conversation-cache-mib, ...).

# The front waits 900 s for the engine's READY line by default; STRATA_ENGINE_READY_S=0
# makes it wait as long as the load takes. 0 = forever.
#STRATA_ENGINE_READY_S="0"
