VLLM_API_KEY="sk-SECRET_API_KEY"

# Tensor-parallel GPUs; the degree is derived from the device count unless
# LLM_TENSOR_PARALLEL_SIZE is set (default: all eight)
#CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
#LLM_TENSOR_PARALLEL_SIZE=8

# Context length and concurrent sequences (default: 512k / 32)
#LLM_MAX_MODEL_LEN=524288
#LLM_MAX_NUM_SEQS=32

# Per-step scheduling budget in tokens (default: 4096). Raise it to fit the
# spec-decode slot overhead — roughly max_num_seqs × (1 + num_speculative_
# tokens) — otherwise vLLM shrinks the schedule and caps batch throughput.
#LLM_MAX_NUM_BATCHED_TOKENS=4096

# DSpark speculative-decode depth (default: 3, the vision profile validated
# on this host). Acceptance falls off sharply past ~4-5 draft positions.
#LLM_NUM_SPECULATIVE_TOKENS=3

# GPU memory ceiling (default: 0.960)
#LLM_GPU_MEMORY_UTILIZATION=0.960

# Default thinking effort for requests that do not set one
# (none = off, max/xhigh = maximum; the model default applies when unset)
#LLM_REASONING_EFFORT="max"

# Turn thinking off entirely (true/false; the model default is on)
#LLM_ENABLE_THINKING=false

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
