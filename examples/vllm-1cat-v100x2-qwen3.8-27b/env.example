VLLM_API_KEY="sk-SECRET_API_KEY"

# Tensor-parallel GPUs; the run script falls back to 0,1
#CUDA_VISIBLE_DEVICES="0,1,2,3"

# Enable the fork's automatic MTP4 speculative decoding (default: off)
#VLLM_1CAT_ENABLE_SM70_MTP_DEFAULTS=1

# Default thinking effort for requests that do not set one
# (low, medium, xhigh; the model default is xhigh)
#LLM_REASONING_EFFORT="medium"

# Context length per slot and number of parallel slots
#LLM_MAX_MODEL_LEN=131072
#LLM_MAX_NUM_SEQS=8

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"