VLLM_API_KEY="sk-SECRET_API_KEY"

# Tensor-parallel GPUs; the degree is derived from the device count unless
# LLM_TENSOR_PARALLEL_SIZE is set (default: all eight)
#CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
#LLM_TENSOR_PARALLEL_SIZE=8

# Context length and concurrent sequences (default: 512k / 16)
#LLM_MAX_MODEL_LEN=524288
#LLM_MAX_NUM_SEQS=16

# GPU memory utilization (default: 0.88)
#LLM_GPU_MEMORY_UTILIZATION=0.88

# Default thinking effort for requests that do not set one
# (none = off, max/xhigh = maximum; the model default applies when unset)
#LLM_REASONING_EFFORT="max"

# Turn thinking off entirely (true/false; the model default is on)
#LLM_ENABLE_THINKING=false

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
