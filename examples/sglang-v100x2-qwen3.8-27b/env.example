SGLANG_API_KEY="sk-SECRET_API_KEY"

# Runtime virtualenv built from source at the instance path (see README);
# the run script falls back to /opt/llm-serv/sglang/.venv
#SGLANG_VENV="/opt/llm-serv/sglang/.venv"

# Tensor-parallel GPUs; the degree is derived from the device count unless
# LLM_TENSOR_PARALLEL_SIZE is set (default: 0,1 -> TP2)
#CUDA_VISIBLE_DEVICES="0,1"
#LLM_TENSOR_PARALLEL_SIZE=2

# Speculative decoding (default: DFLASH = measured fastest). Set to none for
# target-only decode, or DSPARK for the DSpark draft instead.
#LLM_SPEC_ALGORITHM="DFLASH"
#LLM_SPEC_DRAFT_MODEL="z-lab/Qwen3.8-27B-DFlash2"
#LLM_SPEC_DFLASH_BLOCK_SIZE=8
#LLM_SPEC_DRAFT_WINDOW_SIZE=2048

# Fork-validated runtime environment; each falls back to a sane default.
# On an NVLink SXM2 host, restore the upstream value NCCL_P2P_LEVEL=NVL.
#NCCL_P2P_LEVEL=
#NCCL_SHM_DISABLE=1
#FLASHINFER_DISABLE_VERSION_CHECK=1
#SGLANG_CUSTOM_ALLREDUCE_ALGO="1stage"
#SGLANG_MAMBA_CONV_DTYPE="float16"
#SGLANG_MAMBA_SSM_DTYPE="float16"
#SGLANG_ENABLE_OVERLAP_PLAN_STREAM=1

# Context length and concurrency. The fastest measured profile on this host:
# 3 slots x 128k with a 393216-token pool at 0.95 memory utilization. 4 slots
# does not fit on 32GB cards (OOM at pool allocation).
#LLM_CONTEXT_LENGTH=131072
#LLM_MAX_TOTAL_TOKENS=393216
#LLM_MAX_RUNNING_REQUESTS=3
#LLM_CUDA_GRAPH_MAX_BS=3

# GPU memory ceiling (default: 0.95) and prefill chunk (default: 8192)
#LLM_MEM_FRACTION_STATIC=0.95
#LLM_CHUNKED_PREFILL_SIZE=8192

# KV cache dtype (default: fp8_e5m2, the 8-bit KV). Halves KV memory versus
# FP16 with no measured speed difference; 'auto' selects FP16 KV.
#LLM_KV_CACHE_DTYPE="fp8_e5m2"

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"