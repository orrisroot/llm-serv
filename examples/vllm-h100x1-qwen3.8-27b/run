#!/usr/bin/env bash
set -euo pipefail

# Instance identity, derived from where this script is installed:
# /opt/llm-serv/<instance>/run
INSTANCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTANCE="$(basename -- "${INSTANCE_DIR}")"

# CUDA and virtualenv environment configuration. CUDA_HOME points at the
# installed CUDA toolkit (overridable from the env file); it and the venv
# bin are put on PATH so vLLM's JIT/tooling finds nvcc and ninja.
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export VIRTUAL_ENV="${INSTANCE_DIR}/.venv"
export PATH="${CUDA_HOME}/bin:${VIRTUAL_ENV}/bin:${PATH}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Load environment configuration file if present
ENV_FILE="/etc/llm-serv/${INSTANCE}.env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "${ENV_FILE}"
  set +a
fi

# Ensure API key is configured. It reaches the server through the environment
# (exported above), never as a command-line flag, so it stays out of ps output.
if [[ -z "${VLLM_API_KEY:-}" ]]; then
  echo "Error: VLLM_API_KEY is not set." >&2
  exit 1
fi

# Server and model configuration
VLLM_BIN="${VIRTUAL_ENV}/bin/vllm"
MODEL_DIR="/opt/llm-serv/models"
MODEL_PATH="Qwen/Qwen3.8-27B-FP8"
MODEL_ALIAS="qwen3.8-27b"

# Tensor-parallel GPUs and degree. The degree defaults to the number of
# visible devices, so a single-GPU host needs only CUDA_VISIBLE_DEVICES.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
if [[ -n "${LLM_TENSOR_PARALLEL_SIZE:-}" ]]; then
  TP_SIZE="${LLM_TENSOR_PARALLEL_SIZE}"
else
  IFS=, read -r -a TP_DEVICES <<< "${CUDA_VISIBLE_DEVICES}"
  TP_SIZE="${#TP_DEVICES[@]}"
fi

# Listen address; both may be overridden from the env file
HOST="${LLM_SERV_HOST:-0.0.0.0}"
PORT="${LLM_SERV_PORT:-8000}"

# Context and concurrency profile. The model is native at 262k; on a single
# H100 with FP8 KV this leaves ample headroom for a high concurrency.
MAX_MODEL_LEN="${LLM_MAX_MODEL_LEN:-262144}"
MAX_NUM_SEQS="${LLM_MAX_NUM_SEQS:-64}"
GPU_MEMORY_UTILIZATION="${LLM_GPU_MEMORY_UTILIZATION:-0.95}"
MAX_NUM_BATCHED_TOKENS="${LLM_MAX_NUM_BATCHED_TOKENS:-8192}"

# Default chat-template overrides, applied to requests that do not set their
# own. The Qwen3.8 template accepts reasoning_effort of low, medium, xhigh
# (model default xhigh), and enable_thinking=false turns thinking off. Both
# overridable from the env file.
EXTRA_ARGS=()
TEMPLATE_KWARGS=()
if [[ -n "${LLM_REASONING_EFFORT:-}" ]]; then
  case "${LLM_REASONING_EFFORT}" in
    low|medium|xhigh) ;;
    *) echo "Error: LLM_REASONING_EFFORT must be one of low, medium, xhigh (got: ${LLM_REASONING_EFFORT})." >&2; exit 1 ;;
  esac
  TEMPLATE_KWARGS+=("\"reasoning_effort\": \"${LLM_REASONING_EFFORT}\"")
fi
if [[ -n "${LLM_ENABLE_THINKING:-}" ]]; then
  case "${LLM_ENABLE_THINKING}" in
    true|false) ;;
    *) echo "Error: LLM_ENABLE_THINKING must be true or false (got: ${LLM_ENABLE_THINKING})." >&2; exit 1 ;;
  esac
  TEMPLATE_KWARGS+=("\"enable_thinking\": ${LLM_ENABLE_THINKING}")
fi
if (( ${#TEMPLATE_KWARGS[@]} > 0 )); then
  EXTRA_ARGS+=(--default-chat-template-kwargs "$(IFS=,; printf '{%s}' "${TEMPLATE_KWARGS[*]}")")
fi

# LLM_ENABLE_MM=true runs the vision encoder data-parallel (--mm-encoder-tp-mode)
if [[ -n "${LLM_ENABLE_MM:-}" ]] && [[ "${LLM_ENABLE_MM}" == "true" ]]; then
  EXTRA_ARGS+=(--mm-encoder-tp-mode data)
fi
# MTP speculative decoding: LLM_MTP_TOKENS is the draft depth (number of
# speculative tokens); when set, it enables the model's MTP head.
MTP_METHOD="mtp"
if [[ -n "${LLM_MTP_TOKENS:-}" ]]; then
  EXTRA_ARGS+=(--speculative-config "{\"method\":\"${MTP_METHOD}\",\"num_speculative_tokens\":${LLM_MTP_TOKENS}}")
fi

# Launch stock vLLM with ${TP_SIZE}-way tensor parallelism. FP8 checkpoint,
# FP8 KV, on the single H100. The model is a hybrid dense (linear attention
# + full attention) multimodal; `--reasoning-parser qwen3` keeps the
# thinking block out of `message.content`.
exec "${VLLM_BIN}" serve "${MODEL_DIR}/${MODEL_PATH}" \
  --served-model-name "${MODEL_ALIAS}" \
  --trust-remote-code \
  --tensor-parallel-size "${TP_SIZE}" \
  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION}" \
  --max-model-len "${MAX_MODEL_LEN}" \
  --max-num-seqs "${MAX_NUM_SEQS}" \
  --max-num-batched-tokens "${MAX_NUM_BATCHED_TOKENS}" \
  --kv-cache-dtype fp8 \
  --reasoning-parser qwen3 \
  --tool-call-parser qwen3_coder \
  --enable-auto-tool-choice \
  "${EXTRA_ARGS[@]}" \
  --host "${HOST}" \
  --port "${PORT}"
