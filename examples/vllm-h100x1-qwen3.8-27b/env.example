VLLM_API_KEY="sk-SECRET_API_KEY"

# GPU exposed to the engine; TP degree is derived from the device count
# unless LLM_TENSOR_PARALLEL_SIZE is set (default: single GPU 0).
#CUDA_VISIBLE_DEVICES="0"
#LLM_TENSOR_PARALLEL_SIZE=1

# Context length and concurrent sequences (default: 262144 / 64)
#LLM_MAX_MODEL_LEN=262144
#LLM_MAX_NUM_SEQS=64

# Per-step scheduling budget in tokens (default: 8192)
#LLM_MAX_NUM_BATCHED_TOKENS=8192

# GPU memory utilization (default: 0.95)
#LLM_GPU_MEMORY_UTILIZATION=0.95

# Default thinking effort for requests that do not set one
# (low/medium/xhigh; the model default is xhigh)
#LLM_REASONING_EFFORT="medium"

# Turn thinking off entirely (true/false)
#LLM_ENABLE_THINKING=false

# Multimodal: run the vision encoder data-parallel (one small tower, and
# TP adds more comms than it saves). Requires the multimodal path compiled in.
#LLM_ENABLE_MM=true

# Built-in MTP speculative decoding. LLM_MTP_TOKENS is the draft depth
# (number of speculative tokens); uncomment to enable the MTP head.
#LLM_MTP_TOKENS=4

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
