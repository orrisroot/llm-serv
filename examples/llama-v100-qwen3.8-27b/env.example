LLAMA_API_KEY="sk-SECRET_API_KEY"

# GPUs to use; the run script falls back to 0,1.
# 3-GPU profile: 0,1,2 (with LLM_TENSOR_SPLIT=34,35,27)
#CUDA_VISIBLE_DEVICES="0,1"

# GPU tensor split; default 34,30 for 2 GPUs.
# 3-GPU validated profile: 34,35,27 (equal splits OOM at load time)
#LLM_TENSOR_SPLIT="34,30"

# Parallel slots and total context across them (default: 2 / 512k)
# 3-GPU validated profile: 8 / 1048576 (128k per slot)
#LLM_N_PARALLEL=2
#LLM_TOTAL_CTX=524288

# Optional; the run script falls back to 0.0.0.0:8000
#LLM_SERV_HOST="127.0.0.1"
#LLM_SERV_PORT="8001"
