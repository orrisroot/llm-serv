#!/usr/bin/env bash
set -euo pipefail

# Instance identity, derived from where this script is installed:
# /opt/llm-serv/<instance>/run
INSTANCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTANCE="$(basename -- "${INSTANCE_DIR}")"

# CUDA environment configuration. 12.8 is the last toolkit supporting
# Volta (sm_70); CUDA 13 removed the architecture entirely.
export CUDA_HOME="/usr/local/cuda-12.8"
export PATH="${CUDA_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Load environment configuration file if present
ENV_FILE="/etc/llm-serv/${INSTANCE}.env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "${ENV_FILE}"
  set +a
fi

# Ensure API key is configured. It reaches the server through the environment
# (exported above), never as a command-line flag, so it stays out of ps output.
if [[ -z "${LLAMA_API_KEY:-}" ]]; then
  echo "Error: LLAMA_API_KEY is not set." >&2
  exit 1
fi

# Server and model configuration
LLAMA_BIN="${INSTANCE_DIR}/bin/llama"
MODEL_DIR="/opt/llm-serv/models"
MODEL_FILE="unsloth/Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q8_K_XL.gguf"
MMPROJ_FILE="unsloth/Qwen3.8-27B-GGUF/mmproj-F16.gguf"
MODEL_ALIAS="qwen3.8-27b"

# Listen address; both may be overridden from the env file
HOST="${LLM_SERV_HOST:-0.0.0.0}"
PORT="${LLM_SERV_PORT:-8000}"

# GPUs to use; overridable from the env file, e.g. for the 3-GPU profile
# set CUDA_VISIBLE_DEVICES=0,1,2 together with LLM_TENSOR_SPLIT=34,35,27.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

# Tensor split and context profile. Defaults are the 2-GPU profile
# (2 slots x 256k tokens). The 3-GPU validated profile, documented in the
# README, is LLM_TENSOR_SPLIT=34,35,27 / LLM_N_PARALLEL=8 /
# LLM_TOTAL_CTX=1048576. All overridable from the env file.
TENSOR_SPLIT="${LLM_TENSOR_SPLIT:-34,30}"
N_PARALLEL="${LLM_N_PARALLEL:-2}"
TOTAL_CTX="${LLM_TOTAL_CTX:-524288}"

# Launch llama-server with the V100 tensor split and native MTP. The 3-GPU
# split 34,35,27 is NOT a typo: equal splits OOM at load time, see README.
exec "${LLAMA_BIN}" serve \
  -m "${MODEL_DIR}/${MODEL_FILE}" \
  --mmproj "${MODEL_DIR}/${MMPROJ_FILE}" \
  --alias "${MODEL_ALIAS}" \
  -ngl 99 \
  -ts "${TENSOR_SPLIT}" \
  -np "${N_PARALLEL}" \
  -c "${TOTAL_CTX}" \
  -ctk q8_0 \
  -ctv q8_0 \
  --no-kv-unified \
  --cache-reuse 256 \
  --metrics \
  --image-min-tokens 1024 \
  --reasoning-preserve \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --jinja \
  --host "${HOST}" \
  --port "${PORT}"
